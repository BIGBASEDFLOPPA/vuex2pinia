{
  "name": "vuex2pinia",
  "version": "0.1.0",
  "description": "Codemod for migrating Vuex stores and components to Pinia",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vuex2pinia": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --clean && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "tsup src/index.ts src/cli.ts --format esm --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pinia": "^4.0.3",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vue": "^3.5.43",
    "vuex": "^4.1.0"
  },
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@vue/compiler-sfc": "^3.5.41",
    "cac": "^7.0.0",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1",
    "recast": "^0.24.0"
  },
  "keywords": [
    "vuex",
    "pinia",
    "codemod",
    "vue",
    "migration"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
